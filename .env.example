# REQUIRED: comma-separated admin emails (full access). Leads (emails on tasks) get limited access.
ADMIN_EMAILS=admin1@example.com,admin2@example.com
# production => Secure cookies, HSTS. Always set when deployed behind HTTPS.
NODE_ENV=production
# Behind a reverse proxy / PaaS (Render, Fly, nginx): number of proxy hops, so client IPs are correct
TRUST_PROXY=1
# Bind address. Keep 127.0.0.1 behind a reverse proxy; use 0.0.0.0 only on a PaaS
HOST=127.0.0.1
# Copy to .env (or export these) to enable real email sending
PORT=3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app-password
MAIL_FROM="NABC 2027 Planner <you@example.com>"
APP_URL=http://localhost:3000
