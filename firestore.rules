rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Access list lives in the database (config/access: { admins: [...], leads: [...] }), NOT in this public repo.
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }
    function access() { return get(/databases/$(database)/documents/config/access).data; }
    function isAdmin() { return signedIn() && me() in access().admins; }
    function isLead() { return signedIn() && me() in access().leads; }
    function isMember() { return isAdmin() || isLead(); }

    match /config/access   { allow read: if isMember(); allow write: if isAdmin(); }
    match /config/settings { allow read: if isMember(); allow write: if isAdmin(); }

    match /tasks/{id} {
      allow read: if isMember();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isLead()
            && resource.data.leadEmail == me()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt', 'remindNow'])
            && request.resource.data.status in ['todo', 'in_progress', 'blocked', 'done']
            && request.resource.data.notes is string && request.resource.data.notes.size() <= 4000);
    }

    match /milestones/{id} { allow read: if isMember(); allow write: if isAdmin(); }
    match /venues/{id}     { allow read: if isMember(); allow write: if isAdmin(); }

    // Written only by the reminder job (Admin SDK bypasses rules)
    match /reminderLog/{id} { allow read: if isAdmin(); allow write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
